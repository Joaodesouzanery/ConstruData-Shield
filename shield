parse_args() {
  for arg in "$@"; do
    case "$arg" in
      URL=*) URL="${arg#URL=}" ;;
      REPO=*) REPO="${arg#REPO=}" ;;
      CONFIG=*) CONFIG="${arg#CONFIG=}" ;;
      OUTPUT=*) OUTPUT="${arg#OUTPUT=}" ;;
      ID=*) ID="${arg#ID=}" ;;
      CLEAN=*) CLEAN="${arg#CLEAN=}" ;;
      PIPELINE_TESTING=*) PIPELINE_TESTING="${arg#PIPELINE_TESTING=}" ;;
      REBUILD=*) REBUILD="${arg#REBUILD=}" ;;
      WORKSPACE=*) WORKSPACE="${arg#WORKSPACE=}" ;;
    esac
  done
}

is_temporal_ready() {
  docker compose -f "$COMPOSE_FILE" exec -T temporal \
    temporal operator cluster health --address localhost:7233 2>/dev/null | grep -q "SERVING"
}

ensure_containers() {
  if is_temporal_ready; then
    return 0
  fi

  echo "Starting ConstruData Shield containers..."
  if [ "$REBUILD" = "true" ]; then
    echo "Rebuilding with --no-cache..."
    docker compose -f "$COMPOSE_FILE" build --no-cache worker
  fi
  docker compose -f "$COMPOSE_FILE" up -d --build

  echo "Waiting for Temporal to be ready..."
  for i in $(seq 1 30); do
    if is_temporal_ready; then
      echo "Temporal is ready!"
      return 0
    fi
    if [ "$i" -eq 30 ]; then
      echo "Timeout waiting for Temporal"
      exit 1
    fi
    sleep 2
  done
}

cmd_start() {
  parse_args "$@"

  if [ -z "$URL" ] || [ -z "$REPO" ]; then
    echo "ERROR: URL and REPO are required"
    echo "Usage: ./shield start URL=<url> REPO=<name>"
    exit 1
  fi

  # Check for API key
  if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    if [ "$CLAUDE_CODE_USE_BEDROCK" != "1" ] && [ "$CLAUDE_CODE_USE_VERTEX" != "1" ]; then
      echo "ERROR: Set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in .env"
      exit 1
    fi
  fi

  # Determine container path for REPO
  case "$REPO" in
    /repos/*)
      CONTAINER_REPO="$REPO"
      ;;
    *)
      if [ ! -d "./repos/$REPO" ]; then
        echo "ERROR: Repository not found at ./repos/$REPO"
        echo "Place your target repository under the ./repos/ directory"
        exit 1
      fi
      CONTAINER_REPO="/repos/$REPO"
      ;;
  esac

  # Handle custom OUTPUT directory
  if [ -n "$OUTPUT" ]; then
    mkdir -p "$OUTPUT"
    chmod 777 "$OUTPUT"
    export OUTPUT_DIR="$OUTPUT"
  fi

  # Ensure directories exist
  mkdir -p ./audit-logs ./credentials
  chmod 777 ./audit-logs

  if [ -d "./repos/$REPO" ]; then
    mkdir -p "./repos/$REPO/deliverables"
    chmod 777 "./repos/$REPO/deliverables"
  fi

  ensure_containers

  # Build optional args
  ARGS=""
  [ -n "$CONFIG" ] && ARGS="$ARGS --config $CONFIG"
  if [ -n "$OUTPUT" ]; then
    ARGS="$ARGS --output /app/output"
  fi
  [ "$PIPELINE_TESTING" = "true" ] && ARGS="$ARGS --pipeline-testing"
  [ -n "$WORKSPACE" ] && ARGS="$ARGS --workspace $WORKSPACE"

  # Submit workflow
  docker compose -f "$COMPOSE_FILE" exec -T worker \
    node dist/temporal/client.js "$URL" "$CONTAINER_REPO" $ARGS
}

cmd_logs() {
  parse_args "$@"

  if [ -z "$ID" ]; then
    echo "ERROR: ID is required"
    echo "Usage: ./shield logs ID=<workflow-id>"
    exit 1
  fi

  WORKFLOW_LOG=""
  if [ -f "./audit-logs/${ID}/workflow.log" ]; then
    WORKFLOW_LOG="./audit-logs/${ID}/workflow.log"
  fi

  if [ -n "$WORKFLOW_LOG" ]; then
    echo "Tailing workflow log: $WORKFLOW_LOG"
    tail -f "$WORKFLOW_LOG"
  else
    echo "ERROR: Workflow log not found for ID: $ID"
    echo "Check http://localhost:8233 for workflow details"
    exit 1
  fi
}

cmd_workspaces() {
  echo ""
  echo "  ConstruData Shield - Workspaces"
  echo "  ================================"
  echo ""

  if [ ! -d "./audit-logs" ]; then
    echo "  No workspaces found."
    return
  fi

  printf "  %-24s %-10s %-30s %s\n" "SESSION ID" "STATUS" "TARGET" "STARTED"
  printf "  %-24s %-10s %-30s %s\n" "----------" "------" "------" "-------"

  for session_dir in ./audit-logs/*/; do
    if [ -f "${session_dir}session.json" ]; then
      SESSION_ID=$(basename "$session_dir")
      STATUS=$(python3 -c "import json; d=json.load(open('${session_dir}session.json')); print(d.get('status','unknown'))" 2>/dev/null || echo "unknown")
      TARGET=$(python3 -c "import json; d=json.load(open('${session_dir}session.json')); print(d.get('webUrl','N/A')[:28])" 2>/dev/null || echo "N/A")
      STARTED=$(python3 -c "import json; d=json.load(open('${session_dir}session.json')); print(d.get('startedAt','N/A')[:19])" 2>/dev/null || echo "N/A")

      # Color based on status
      case "$STATUS" in
        completed) STATUS_FMT="\033[32m${STATUS}\033[0m" ;;
        running)   STATUS_FMT="\033[33m${STATUS}\033[0m" ;;
        failed)    STATUS_FMT="\033[31m${STATUS}\033[0m" ;;
        *)         STATUS_FMT="$STATUS" ;;
      esac

      printf "  %-24s ${STATUS_FMT}%-$((10 - ${#STATUS}))s %-30s %s\n" "$SESSION_ID" "" "$TARGET" "$STARTED"
    fi
  done

  echo ""
  TOTAL=$(find ./audit-logs -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
  echo "  Total: $TOTAL workspace(s)"
  echo ""
}

cmd_status() {
  parse_args "$@"

  if [ -z "$ID" ]; then
    echo "ERROR: ID is required"
    echo "Usage: ./shield status ID=<workflow-id>"
    exit 1
  fi

  SESSION_FILE="./audit-logs/${ID}/session.json"
  if [ ! -f "$SESSION_FILE" ]; then
    echo "ERROR: Session not found for ID: $ID"
    exit 1
  fi

  echo ""
  echo "  ConstruData Shield - Pipeline Status"
  echo "  ======================================"

  python3 -c "
import json, sys

with open('$SESSION_FILE') as f:
    d = json.load(f)

print(f\"  Session:  {d['sessionId']}\")
print(f\"  Target:   {d['webUrl']}\")
print(f\"  Status:   {d['status']}\")
print(f\"  Started:  {d['startedAt']}\")
print()
print('  Agents:')
print(f\"  {'Name':<22} {'Status':<12} {'Duration':<12} {'Cost':<10}\")
print(f\"  {'-'*22} {'-'*12} {'-'*12} {'-'*10}\")

total_cost = 0
total_ms = 0
for name, agent in d.get('agents', {}).items():
    status = 'OK' if agent['success'] else 'FAILED'
    ms = agent.get('duration_ms', 0)
    cost = agent.get('cost_usd', 0)
    total_cost += cost
    total_ms += ms
    dur = f'{ms/1000:.1f}s' if ms < 60000 else f'{ms//60000}m {(ms%60000)//1000}s'
    print(f\"  {name:<22} {status:<12} {dur:<12} \${cost:.2f}\")

print(f\"  {'-'*22} {'-'*12} {'-'*12} {'-'*10}\")
dur = f'{total_ms//60000}m {(total_ms%60000)//1000}s'
print(f\"  {'TOTAL':<22} {'':<12} {dur:<12} \${total_cost:.2f}\")
print()
" 2>/dev/null || echo "  Error reading session data"
}

cmd_dashboard() {
  DASHBOARD_PATH="$(cd "$(dirname "$0")" && pwd)/dashboard/index.html"
  if [ ! -f "$DASHBOARD_PATH" ]; then
    echo "ERROR: Dashboard not found at $DASHBOARD_PATH"
    exit 1
  fi

  echo "Opening dashboard..."

  # Cross-platform open
  if command -v xdg-open &>/dev/null; then
    xdg-open "$DASHBOARD_PATH"
  elif command -v open &>/dev/null; then
    open "$DASHBOARD_PATH"
  elif command -v start &>/dev/null; then
    start "$DASHBOARD_PATH"
  else
    echo "Dashboard file: $DASHBOARD_PATH"
    echo "Open this file in your browser"
  fi
}

cmd_stop() {
  parse_args "$@"

  if [ "$CLEAN" = "true" ]; then
    docker compose -f "$COMPOSE_FILE" down -v
  else
    docker compose -f "$COMPOSE_FILE" down
  fi
}

# Main dispatch
case "${1:-help}" in
  start)
    shift
    cmd_start "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  workspaces)
    cmd_workspaces
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  dashboard)
    cmd_dashboard
    ;;
  stop)
    shift
    cmd_stop "$@"
    ;;
  help|--help|-h|*)
    show_help
    ;;
esac
