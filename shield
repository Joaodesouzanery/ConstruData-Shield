case "$OSTYPE" in
  msys*) export MSYS_NO_PATHCONV=1 ;;
esac

COMPOSE_FILE="docker-compose.yml"

# Load .env if present
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

